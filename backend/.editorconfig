root = false

[*.cs]
# Underscored test names read like sentences.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
# xUnit fixtures and test classes are public by convention.
dotnet_diagnostic.CA1515.severity = none

# EF Core migrations are generated; analyzers skip them.
[src/ITask.Api/Migrations/*.cs]
generated_code = true
