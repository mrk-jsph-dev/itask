{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer",
    "AutoMigrate": false
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "RequireConfirmedEmail": true
  },
  "Turnstile": {
    "SecretKey": ""
  },
  "RateLimits": {
    "PerMinute": 120,
    "AuthPerMinute": 10
  },
  "Ai": {
    "Enabled": false,
    "DailyRequestsPerUser": 20
  },
  "Demo": {
    "Enabled": false
  },
  "Admin": {
    "Emails": ""
  }
}
